#!/bin/bash
# A stand-in for `firmwarekit create` that follows the preparer contract (JSON events on stdout, the last one done
# with its lock) without touching firmware.
#
#     fake-firmwarekit create --entry ENTRY.json --ipsw IPSW --out STAGING [--seed S]
#                             [--helper PATH] [--cache DIR] [--sibling-entry JSON --sibling-ipsw IPSW] [--skip-setup] [--jailbreak]
#
# FAKE_MODE picks the run: ok (default), error, sha (a sha_mismatch error), crash, incomplete, slow (waits for
# SIGTERM after step 2, with a read-only nand/ like the real one). FAKE_ARGV, if set, gets argv as JSON.
trap 'exit 143' TERM
mode="${FAKE_MODE:-ok}"
json() { local s="${1//\\/\\\\}"; s="${s//\"/\\\"}"; printf '"%s"' "$s"; }
if [ -n "${FAKE_ARGV:-}" ]; then
    { printf '['; sep=; for a in "$@"; do printf '%s' "$sep"; json "$a"; sep=,; done; printf ']'; } > "$FAKE_ARGV"
fi
[ "$1" = create ] || { echo "usage: fake-firmwarekit create ..." >&2; exit 2; }
shift
while [ $# -gt 0 ]; do
    case "$1" in
        --entry) entry="$2" ;; --ipsw) ipsw="$2" ;; --out) out="$2" ;; --seed) seed="$2" ;; --cache) cache="$2" ;;
        --helper|--sibling-entry|--sibling-ipsw) ;;
        --skip-setup|--jailbreak) shift; continue ;;
        *) echo "fake: unknown argument $1" >&2; exit 2 ;;
    esac
    shift 2
done
[ -n "${entry:-}" ] && [ -n "${ipsw:-}" ] && [ -n "${out:-}" ] || { echo "fake: --entry, --ipsw and --out are required" >&2; exit 2; }
field() { plutil -extract "$1" raw -o - "$entry" 2>/dev/null; }

echo '{"event": "begin", "steps": 3, "seconds": [5, 10, 70]}'
echo '{"event": "step", "index": 1, "name": "Decrypting"}'
echo '{"event": "progress", "fraction": 0, "detail": "Decrypting the firmware — 0 s"}'
if [ -n "${cache:-}" ]; then   # FirmwareKit's layout: decrypted-v<format>/<sha1>/<identity digest>/ (DecryptionCache.swift)
    dir="$cache/decrypted-v2/$(field source.sha1)/$(printf '0%.0s' {1..64})"
    mkdir -p "$dir" && printf x > "$dir/rootfs.dmg"
fi
echo '{"event": "progress", "fraction": 0.5, "detail": "Decrypting the firmware — 1 s"}'
echo '{"event": "progress", "fraction": 1, "detail": "Decrypting the firmware — 2 s"}'
case "$mode" in
    crash) echo "fake: crashing" >&2; exit 3 ;;
    error) echo '{"event": "error", "code": "key_missing", "message": "no key for rootfs"}'; exit 1 ;;
    sha) echo '{"event": "error", "code": "sha_mismatch", "message": "sha1 of the IPSW"}'; exit 1 ;;
esac
echo '{"event": "step", "index": 2, "name": "Building the NAND"}'
mkdir -p "$out/nand"
printf NAND > "$out/nand/store"
truncate -s 1g "$out/nand/store" 2>/dev/null || dd if=/dev/null of="$out/nand/store" bs=1 seek=1073741824 2>/dev/null   # 1 GiB apparent, a few KiB allocated
if [ "$(field board)" = n72ap ]; then   # N72Recipe: the direct iBoot, NOR and KBAG table, no kboot.bin
    for name in iBoot.bin nor.bin gid-blobs.bin; do printf '%s' "$name" > "$out/$name"; done
else
    printf KBOOT > "$out/kboot.bin"
fi
if [ "$(field recipe.options.writable_nor)" = true ]; then
    head -c 4096 /dev/zero | LC_ALL=C tr '\0' '\377' > "$out/nor.bin"
fi
chmod 444 "$out/nand/store"
chmod 555 "$out/nand"
if [ "$mode" = slow ]; then
    echo '{"event": "warning", "message": "waiting to be cancelled"}'
    sleep 60 & wait $!
    exit 4
fi
echo '{"event": "step", "index": 3, "name": "Finishing setup"}'
i=0
for f in 0 0.25 0.5 0.75 1; do echo "{\"event\": \"progress\", \"fraction\": $f, \"detail\": \"Starting iOS — $((i * 10)) s\"}"; i=$((i + 1)); done
udid="$(printf '%s' "${seed:-}" | shasum -a 1 | cut -c1-40)"
[ -e "$out/identity.json" ] && { echo "fake: identity.json exists" >&2; exit 1; }
(umask 077; printf '{"udid": "%s", "die-id": ["0x00000123", "0x00000456"]}' "$udid" > "$out/identity.json")
if [ "$mode" != incomplete ]; then
    printf '{"format": 1, "build": %s, "product_version": %s, "identity": {"seed": %s, "udid": "%s", "die_id": "0x00000123:0x00000456"}, "inputs": {}}' \
        "$(json "$(field build)")" "$(json "$(field version)")" "$( [ -n "${seed+x}" ] && json "$seed" || echo null)" "$udid" > "$out/device.lock.json"
fi
echo '{"event": "done", "lock": "device.lock.json"}'
